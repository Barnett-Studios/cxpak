[package]
name = "tree-sitter-markdown-updated"
description = "Markdown grammar for tree-sitter"
version = "0.1.0"
keywords = ["incremental", "parsing", "markdown"]
categories = ["parsing", "text-editors"]
repository = "https://github.com/c-gamble/tree-sitter-markdown"
edition = "2018"
license = "MIT"

build = "bindings/rust/build.rs"
include = [
  "/bindings/rust/",
  "/src/",
  "/CHANGELOG.md",
  "/grammar.js",
  "/LICENSE",
  "/README.md"
]

[lib]
path = "bindings/rust/lib.rs"

[dependencies]
tree-sitter = ">=0.21.0"

[build-dependencies]
cc = "1.0"
